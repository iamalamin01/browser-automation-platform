# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/browser_automation"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development

# Screenshots
SCREENSHOTS_DIR=./uploads/screenshots

# Faker API (synthetic test users)
FAKER_API_URL=https://faker.tatsuyo.xyz/faker_app/user/generate.php
